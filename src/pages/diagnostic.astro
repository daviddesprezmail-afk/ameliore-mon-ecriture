
---
import "../styles/global.css";
---

<html lang="fr">
  <head>
    <meta charset="utf-8" />
    <title>Diagnostic d'écriture enfant</title>
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta
      name="description"
      content="Demandez un diagnostic personnalisé de l'écriture de votre enfant."
    />
  </head>

  <body>
    <header class="site-header">
      <a href="/" class="logo">
        <img
          src="/images/logo.png"
          alt="Améliore Mon Écriture"
        />
      </a>

      <nav>
        <a href="/">Accueil</a>
        <a href="/diagnostic">Diagnostic</a>
        <a href="/contact">Contact</a>
        <a href="/blog">Blog</a>
      </nav>
    </header>

    <main class="container">
      <section>
        <h1>Diagnostic de l'écriture de votre enfant</h1>

        <p>
          Un bilan personnalisé réalisé par une graphothérapeute
          pour mieux comprendre les difficultés d'écriture de votre
          enfant et l'aider à progresser.
        </p>

        <p>
          Préparez votre demande directement sur cette page.
          Aucun paiement n'est demandé à cette étape.
        </p>

        <a href="#demande">
          <button type="button">Préparer ma demande</button>
        </a>
      </section>

      <section>
        <h2>Ce que vous allez recevoir</h2>
        <ul>
          <li>Une analyse détaillée de l'écriture</li>
          <li>Les points à améliorer</li>
          <li>Des conseils personnalisés</li>
          <li>Un bilan clair et compréhensible</li>
        </ul>
      </section>

      <section>
        <h2>Comment ça fonctionne ?</h2>
        <ol>
          <li>Vous préparez votre demande sur cette page.</li>
          <li>Vous copiez le message et l'envoyez par e-mail avec 3 photos.</li>
          <li>Une graphothérapeute prépare le diagnostic.</li>
          <li>Nous vous envoyons un lien de paiement sécurisé.</li>
          <li>Après confirmation du paiement, nous vous transmettons le bilan par e-mail.</li>
        </ol>
      </section>

      <section>
        <h2>Pour qui ?</h2>
        <ul>
          <li>Écriture peu lisible</li>
          <li>Fatigue ou inconfort pendant l'écriture</li>
          <li>Difficultés rencontrées à l'école</li>
        </ul>
      </section>

      <section id="demande">
        <h2>Préparez votre demande</h2>

        <p>
          Remplissez les champs ci-dessous. Votre message sera
          automatiquement préparé et pourra être copié en un clic.
        </p>

        <div class="demande-diagnostic">
          <div class="champ-demande">
            <label for="age-classe">Âge et classe de votre enfant</label>
            <input
              id="age-classe"
              type="text"
              placeholder="Ex. : 8 ans, CE2"
            />
          </div>

          <div class="champ-demande">
            <label for="difficultes">Quelles difficultés avez-vous remarquées ?</label>
            <textarea
              id="difficultes"
              rows="3"
              placeholder="Ex. : écriture peu lisible, lenteur, fatigue..."
            ></textarea>
          </div>

          <div class="champ-demande">
            <label for="depuis-quand">Depuis quand ces difficultés existent-elles ?</label>
            <input
              id="depuis-quand"
              type="text"
              placeholder="Ex. : depuis le début de l'année scolaire"
            />
          </div>

          <div class="champ-demande">
            <label for="questions">Vos questions ou précisions (facultatif)</label>
            <textarea
              id="questions"
              rows="3"
              placeholder="Ajoutez ici les informations que vous jugez utiles."
            ></textarea>
          </div>

          <h3>Votre message prêt à copier</h3>

          <textarea
            id="message-diagnostic"
            rows="12"
            readonly
            aria-label="Message préparé pour votre demande de diagnostic"
          >Bonjour,

Je souhaite demander un diagnostic de l'écriture de mon enfant.

Âge et classe :
Difficultés observées :
Depuis quand :
Mes questions ou précisions :

Je joins 3 photos de son écriture à ce message.

Merci par avance pour votre retour.

Cordialement</textarea>

          <button id="copier-message" type="button">
            📋 Copier le message
          </button>

          <p
            id="confirmation-copie"
            role="status"
            aria-live="polite"
          ></p>

          <div class="instructions-envoi">
            <h3>Dernière étape : envoyer votre demande</h3>

            <ol>
              <li>Copiez le message avec le bouton ci-dessus.</li>
              <li>Ouvrez votre messagerie habituelle, sur téléphone ou ordinateur.</li>
              <li>Créez un e-mail adressé à <strong>contact@ameliore-mon-ecriture.fr</strong>.</li>
              <li>Collez le message, puis ajoutez 3 photos lisibles de l'écriture de votre enfant.</li>
              <li>Envoyez votre e-mail : votre demande sera alors transmise.</li>
            </ol>

            <p>
              Pensez à ne joindre que les photos nécessaires au diagnostic.
              Les informations saisies dans le formulaire ne sont pas envoyées
              automatiquement : elles servent à préparer le message sur cette page.
            </p>
          </div>
        </div>
      </section>

      <section>
        <h2>Diagnostic complet : 14,99 €</h2>

        <p>
          Le paiement intervient uniquement lorsque votre diagnostic est prêt.
          Nous vous transmettrons alors un lien de paiement sécurisé.
          Le bilan sera envoyé par e-mail après confirmation du règlement.
        </p>
      </section>
    </main>

    <style>
      .demande-diagnostic {
        margin-top: 1.5rem;
        padding: 1.25rem;
        border: 1px solid #d8d8d8;
        border-radius: 12px;
        background: #fff;
      }

      .champ-demande {
        margin-bottom: 1.2rem;
      }

      .champ-demande label {
        display: block;
        margin-bottom: 0.4rem;
        font-weight: 600;
      }

      .champ-demande input,
      .champ-demande textarea,
      #message-diagnostic {
        display: block;
        width: 100%;
        box-sizing: border-box;
        padding: 0.8rem;
        border: 1px solid #bbb;
        border-radius: 6px;
        font: inherit;
      }

      .champ-demande textarea,
      #message-diagnostic {
        resize: vertical;
      }

      #message-diagnostic {
        margin-bottom: 1rem;
        background: #f7f7f7;
        line-height: 1.6;
      }

      .instructions-envoi {
        margin-top: 1.5rem;
        padding-top: 1rem;
        border-top: 1px solid #ddd;
      }

      .instructions-envoi li {
        margin-bottom: 0.6rem;
      }

      #confirmation-copie {
        font-weight: 600;
      }

      @media (max-width: 600px) {
        .demande-diagnostic {
          padding: 1rem;
        }

        #copier-message {
          width: 100%;
          padding: 0.9rem;
        }
      }
    </style>

    <script>
      const ageClasse = document.querySelector("#age-classe");
      const difficultes = document.querySelector("#difficultes");
      const depuisQuand = document.querySelector("#depuis-quand");
      const questions = document.querySelector("#questions");
      const message = document.querySelector("#message-diagnostic");
      const boutonCopier = document.querySelector("#copier-message");
      const confirmation = document.querySelector("#confirmation-copie");

      function actualiserMessage() {
        message.value = `Bonjour,

Je souhaite demander un diagnostic de l'écriture de mon enfant.

Âge et classe : ${ageClasse.value.trim() || "À compléter"}
Difficultés observées : ${difficultes.value.trim() || "À compléter"}
Depuis quand : ${depuisQuand.value.trim() || "À compléter"}
Mes questions ou précisions : ${questions.value.trim() || "Aucune précision pour le moment"}

Je joins 3 photos de son écriture à ce message.

Merci par avance pour votre retour.

Cordialement`;
      }

      [ageClasse, difficultes, depuisQuand, questions].forEach((champ) => {
        champ.addEventListener("input", actualiserMessage);
      });

      boutonCopier.addEventListener("click", async () => {
        actualiserMessage();
        confirmation.textContent = "";

        try {
          await navigator.clipboard.writeText(message.value);
          confirmation.textContent =
            "✓ Message copié ! Vous pouvez maintenant le coller dans votre e-mail.";
        } catch {
          message.focus();
          message.select();
          message.setSelectionRange(0, message.value.length);

          const copieReussie = document.execCommand("copy");

          confirmation.textContent = copieReussie
            ? "✓ Message copié ! Vous pouvez maintenant le coller dans votre e-mail."
            : "La copie automatique n'a pas fonctionné. Sélectionnez le texte ci-dessus et copiez-le manuellement.";
        }
      });

      actualiserMessage();
    </script>
  </body>
</html>
